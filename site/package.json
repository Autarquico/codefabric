{
  "name": "codefabric-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4",
    "npm": "11.21.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/font-licenses.mjs",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.mjs",
    "test:a11y": "playwright test",
    "check:install": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0"
  }
}
